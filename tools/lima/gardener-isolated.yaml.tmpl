# Minimal Lima profile for isolated Gardener runs.
# Generated by scripts/lima-gardener.sh (do not edit generated copy in /tmp).

vmType: "vz"
arch: "aarch64"
cpus: 4
memory: "8GiB"
disk: "60GiB"

images:
  - location: "https://cloud-images.ubuntu.com/minimal/releases/24.04/release/ubuntu-24.04-minimal-cloudimg-arm64.img"
    arch: "aarch64"

mounts:
  - location: "__REPO_PATH__"
    mountPoint: "/workspace/gardener"
    writable: true

mountType: "virtiofs"

containerd:
  system: false
  user: false

rosetta:
  enabled: true
  binfmt: true

provision:
  - mode: system
    script: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gh \
        build-essential \
        pkg-config \
        libssl-dev \
        libsqlite3-dev \
        unzip \
        jq
  - mode: user
    script: |
      #!/bin/bash
      set -euo pipefail
      if ! command -v cargo >/dev/null 2>&1; then
        curl https://sh.rustup.rs -sSf | sh -s -- -y
      fi
      . "$HOME/.cargo/env"
      rustup component add rustfmt clippy
